# Supabase PostgreSQL: use the Session pooler URI from Project > Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase project settings. Keep the service-role key server-side only.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=ziad-invoices
ZIAD_STORAGE_BACKEND=supabase

ZIAD_SESSION_HOURS=24
ZIAD_MAX_ATTACHMENT_BYTES=104857600
